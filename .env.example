# ── MinIO (Docker infra) ─────────────────────────────────────
MINIO_ROOT_USER=admin
# Password must be ≥ 8 chars (mc rejects short values like "admin")
MINIO_ROOT_PASSWORD=admin1234
FEN_BUCKET_RAW=final-exam-nlp-raw
FEN_BUCKET_AIRFLOW=airflow
FEN_MINIO_ENDPOINT=http://minio:9000
FEN_SOURCE_PREFIX=facebook
FEN_DAGS_PREFIX=fen-exam

# ── Facebook crawl ───────────────────────────────────────────
FEN_GROUP_ID=322453387859386
# Fill your own credentials — do not commit real values
FB_USERNAME=
FB_PASSWORD=
FB_TOTP_SECRET=
FEN_HEADLESS=true
SELENIUM_REMOTE_URL=http://selenium-chrome:4444/wd/hub

# ── Ramcloud — separate API key per stage (do NOT share) ─────
RAMCLOUDS_BASE_URL=https://ramclouds.me/v1

# Fill your own keys — do not commit real values
FEN_CALLIGRAPHY_API_KEY=
FEN_OCR_API_KEY=
FEN_LABEL_GEMINI_API_KEY=
FEN_LABEL_GPT_API_KEY=
FEN_LABEL_DEEPSEEK_API_KEY=
FEN_LABEL_GLM_API_KEY=

# ── Models (override optional) ───────────────────────────────
FEN_CALLIGRAPHY_MODEL=gemini-3.5-flash-low
FEN_OCR_MODEL=gemini-3.5-flash-low
FEN_LABEL_GEMINI_MODEL=gemini-3.6-flash-high
FEN_LABEL_GPT_MODEL=gpt-5.6-luna
FEN_LABEL_DEEPSEEK_MODEL=deepseek-v4-flash
FEN_LABEL_GLM_MODEL=glm-5.3-flash

# ── Services ─────────────────────────────────────────────────
PADDLE_SERVICE_URL=http://paddle-ocr:8080
FEN_RUNTIME=docker
FEN_COMPOSE_PROJECT=fen-exam
# DAG source for Airflow: minio (sidecar sync) | local (bind mount ./dags)
FEN_DAG_SOURCE=minio
AIRFLOW_DAG_SYNC_INTERVAL_SEC=30
# Absolute host path for DockerOperator bind mounts (set by make configure).
# If the path contains spaces, keep quotes: FEN_HOST_PROJECT_DIR="/path/with spaces/repo"
FEN_HOST_PROJECT_DIR=

# ── Crawl rollover (DAG param at trigger; hints only in .env) ──
# catch_bottom=true  → rollover until bottom_year (default 2013) or feed end
# catch_bottom=false → one batch_target batch only
FEN_CATCH_BOTTOM=true
FEN_DEMO_MODE=false
FEN_BATCH_TARGET=10
FEN_SHOULD_CONTINUE=false
# ── Label dual flush (DAG param flush_posts; default 5 images) ─
# FEN_LABEL_FLUSH_POSTS=5

# Demo limits — label dual: ocr_limit=0 = full queue at DAG trigger
FEN_OCR_LIMIT=0
FEN_CALLIGRAPHY_CLASSIFY=true
FEN_CALLIGRAPHY_MAX_IMAGES=3
# Exam stack has no Qdrant — OCR/retry write MinIO only

# ── Airflow ──────────────────────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

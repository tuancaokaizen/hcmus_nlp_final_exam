# Reviewer Phase B — copy to reviewer_test/.env and fill keys.
# Phase B cho giám khảo — copy thành reviewer_test/.env rồi điền key.
# Falls back to repo-root .env if a key is missing here.
# Thiếu key ở đây sẽ fallback sang .env ở root repo.

# ── Ramcloud (shared exam reviewer key) ───────────────────────
# Key dùng chung cho giám khảo / Shared key for graders
RAMCLOUDS_BASE_URL=https://ramclouds.me/v1
FEN_LABEL_GEMINI_API_KEY=sk-lwWzRdnsczrnCXfZbIQVU1xDKCywTmcArvHKYE8LbBTOS1HM
FEN_LABEL_GPT_API_KEY=sk-lwWzRdnsczrnCXfZbIQVU1xDKCywTmcArvHKYE8LbBTOS1HM
FEN_LABEL_GLM_API_KEY=sk-lwWzRdnsczrnCXfZbIQVU1xDKCywTmcArvHKYE8LbBTOS1HM

FEN_LABEL_GEMINI_MODEL=gemini-3.6-flash-high
FEN_LABEL_GPT_MODEL=gpt-5.6-luna
FEN_LABEL_GLM_MODEL=glm-5.3-flash

# ── Paddle OCR HTTP (optional; compose publishes 8088) ───────
# If unreachable, fuse still runs with Gemini-only / paddle_empty flag.
# Không gọi được thì vẫn fuse Gemini-only (flag paddle_empty).
FEN_PADDLE_OCR_URL=http://127.0.0.1:8088/ocr

# ── Run controls ─────────────────────────────────────────────
FEN_REVIEW_LIMIT=50
FEN_REVIEW_GLM=true
FEN_REVIEW_MANIFEST=dataset/top50.jsonl
FEN_GROUP_ID=322453387859386
